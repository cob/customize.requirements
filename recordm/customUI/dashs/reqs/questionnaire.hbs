<tr class='hover:bg-gray-50 transition-colors duration-100'>

          {{! Name }}
          <td class='px-5 py-4 text-gray-600'>{{nome}}</td>

          {{! ID }}
          <td class='px-5 py-4 text-gray-400 font-mono text-xs'>{{score}}</td>

          {{! Status Badge }}
          <td class='px-5 py-4'>
            {{#if (eq percentage 100)}}
              <span class='inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700'>
                <svg class='w-3 h-3' fill='currentColor' viewBox='0 0 20 20'><path fill-rule='evenodd' d='M16.707 5.293a1 1 0 00-1.414 0L8 12.586 4.707 9.293a1 1 0 00-1.414 1.414l4 4a1 1 0 001.414 0l8-8a1 1 0 000-1.414z' clip-rule='evenodd'/></svg>
                Complete
              </span>
            {{else}}
              <span class='inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700'>
                <svg class='w-3 h-3' fill='currentColor' viewBox='0 0 20 20'><path fill-rule='evenodd' d='M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z' clip-rule='evenodd'/></svg>
                In progress
              </span>
            {{/if}}
          </td>

          {{! Progress }}
		  
          <td class='px-5 py-4 '>
            <!-- <div class='flex items-center gap-3'>
              <div class='flex-1 bg-gray-100 rounded-full h-1.5 overflow-hidden'>
                <div
                  class='h-1.5 rounded-full
                    {{#if (eq percentage 100)}}bg-green-500
                    {{else if (eq percentage 0)}}bg-gray-300
                    {{else}}bg-blue-500{{/if}}'
                  style='width: {{percentage}}%'>
                </div>
              </div>
              <span class='text-xs text-gray-500 tabular-nums w-16'>{{answered}}/{{total}}</span>
            </div> -->
			{{! Status Bar Component — receives: total, answered, accepted, toAnswer, notAccepted }}
			<div class='group relative flex w-full h-2.5 rounded-full bg-gray-100 overflow-hidden'>
				<!-- 
				remove overflow-hidden from parent
				<div class='group-hover:grid text-xs absolute hidden w-full rounded-md p-2 text-gray-800 shadow border border-gray-200 -top-24 left-1/2 -translate-x-1/2 z-50 bg-white'>
					Answered ({{answered.total}})<br>
					Accepted ({{accepted.total}})<br>
					To Answer ({{toAnswer.total}})<br>
					Not Accepted ({{notAccepted.total}})
				</div> -->
				<div class='bg-green-500 h-full'   style='width: {{accepted.percentage}}%'    title='Accepted ({{accepted.total}})'></div>
				<div class='bg-blue-500 h-full'  style='width: {{answered.percentage}}%'    title='Answered ({{answered.total}})'></div>
				<div class='bg-amber-400 h-full'  style='width: {{toAnswer.percentage}}%'    title='To answer ({{toAnswer.total}})'></div>
				<div class='bg-red-400 h-full'    style='width: {{notAccepted.percentage}}%'  title='Not accepted ({{notAccepted.total}})'></div>
			</div>
			<div class='text-xs text-gray-400'>
				{{accepted.total}} / {{answered.total}} / {{ toAnswer.total }} / {{notAccepted.total }}
			</div>
          </td>

          {{! Date }}
          <td class='px-5 py-4 text-gray-400 text-xs'>{{dateInfoTimestamp date 'FullDate'}}</td>

          {{! Action }}
          <td class='px-5 py-4 text-right'>
            <a href='/recordm/index.html#/cob.custom-resource/33859:{\"523435\":\"{{id}}\"}/dash' class='text-xs font-medium text-blue-600 hover:text-blue-800 hover:underline transition-colors'>
              View →
            </a>
          </td>

        </tr>